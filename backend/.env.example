# Application Settings
PROJECT_NAME="ASHA Route Optimizer AI"
VERSION="2.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_jwt_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Settings
DATABASE_URL="postgresql://asha_user:asha_password@localhost:5432/asha_route_optimizer_db"
# Fallback to local SQLite if PostgreSQL is unavailable
SQLITE_FALLBACK_URL="sqlite:///./asha_database.db"

# Redis Cache & Message Queue
REDIS_URL="redis://localhost:6379/0"

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5174"]

# AI Engine Settings
RISK_MODEL_TYPE="xgboost" # xgboost | lightgbm
ENABLE_OR_TOOLS=true
